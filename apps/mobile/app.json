{
  "expo": {
    "name": "TerrenoCNR",
    "slug": "terreno-cnr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.gob.cnr.terreno",
      "infoPlist": {
        "NSCameraUsageDescription": "TerrenoCNR requiere acceso a la cámara para capturar fotografías de inspección y leer códigos QR/barras.",
        "NSLocationWhenInUseUsageDescription": "TerrenoCNR requiere su ubicación GPS para georreferenciar inspecciones, puntos, líneas y polígonos en terreno.",
        "NSMicrophoneUsageDescription": "TerrenoCNR requiere el micrófono para grabar notas de voz y transcripción en terreno."
      }
    },
    "android": {
      "package": "cl.gob.cnr.terreno",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0f4c81",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-location",
      "expo-camera",
      "expo-image-picker"
    ]
  }
}
